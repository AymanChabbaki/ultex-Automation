# Port the Express server listens on
PORT=3000

# Arbitrary string you choose; must match what you enter in the Meta
# App Dashboard > Webhooks > Page subscription screen
FB_VERIFY_TOKEN=

# Meta App secret (App Dashboard > Settings > Basic).
# Used to verify the X-Hub-Signature-256 header on incoming webhook POSTs.
FB_APP_SECRET=

# Page Access Token with pages_manage_engagement, pages_read_user_content,
# and pages_manage_metadata (needed to subscribe the Page to webhook
# events). Also used for Instagram comment moderation below, in which
# case it additionally needs instagram_basic + instagram_manage_comments.
PAGE_ACCESS_TOKEN=

# The Facebook Page ID being moderated. Used to ignore comments/replies
# posted by the Page itself (e.g. your own replies) so the bot never
# evaluates or deletes its own activity.
PAGE_ID=

# Optional: Instagram Business/Creator account ID linked to the Page
# above, for moderating Instagram comments too. Same purpose as PAGE_ID
# but for skipping the IG account's own comments. Leave unset if you're
# only moderating the Facebook Page.
IG_USER_ID=

# Optional: App Secret for the separate "Instagram API with Instagram
# Login" product (App Dashboard > Use cases > Instagram API setup --
# it has its own App ID/Secret, distinct from FB_APP_SECRET above).
# Instagram comment webhooks enabled via that product's own "Abonnement
# Webhooks" toggle are signed with this secret, not FB_APP_SECRET.
# Leave unset if you're only moderating the Facebook Page, or if
# Instagram is wired through the classic Page-linked flow instead.
IG_APP_SECRET=

# Graph API version to target. Match this to whatever version your App
# Dashboard's Webhooks fields show as selected (check there if unsure) --
# using a much older version than the app is actually configured for has
# caused mismatched behavior for us before.
GRAPH_API_VERSION=v26.0

# Set to "true" to log the raw JSON of every incoming webhook payload --
# useful when confirming a field's real shape (Meta's docs don't always
# match what's actually sent). Leave unset/false in normal operation.
DEBUG_WEBHOOK_PAYLOAD=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Credentials for the /webhook/dashboard moderation dashboard (HTTP Basic
# Auth). The dashboard shows real commenters' text, so it stays disabled
# (503) until both are set.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
